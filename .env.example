ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_ENGINE_USE_CLAUDE=false

# Product Hunt GraphQL API Developer Token（可选；配置后 producthunt 源正文改走官方 API，绕过 Cloudflare 反爬）
# 获取：https://www.producthunt.com/v2/oauth/applications 创建应用后在 Developer Token 区域生成
PRODUCTHUNT_API_TOKEN=

# 站点数据库连接串：本地开发指向 docker compose 的 PostgreSQL（5433 端口），
# 生产环境为 Neon 连接串（配置在 Vercel 环境变量，不带 -pooler 需加 sslmode=require）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_insight
